# Database: Aiven for PostgreSQL (managed, cloud-hosted)
# Service URI adapted for asyncpg:
DATABASE_URL=postgresql+asyncpg://avnadmin:YOUR_PASSWORD@YOUR_HOST:YOUR_PORT/defaultdb?ssl=require

# Administrator Initial Account (Required for Alembic migration 004_create_admin_account)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_secure_admin_password_here

# Application Security (Required: must be provided via environment variables, no hardcoded defaults)
JWT_SECRET=your_secure_random_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=your_fernet_32_byte_url_safe_base64_encryption_key_here

# Frontend Base URL (for booking links)
FRONTEND_BASE_URL=http://localhost:5173

# CORS: Comma-separated list of allowed origins. No wildcard.
# If unset, falls back to local frontend (localhost) only.
CORS_ORIGINS=https://<kavach-live-url>

# Meeting Providers
JITSI_BASE_URL=https://meet.jit.si

# Email (Brevo / SMTP) - Optional for Phase 0/1; falls back to console logger
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
